# Copy this file to .env after creating the Supabase development project.
# The publishable key is designed for client-side use. Never put a
# service_role or secret key in this file or in the extension.

PAGER_ENV=development
PAGER_SUPABASE_URL=https://your-project-ref.supabase.co
PAGER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
