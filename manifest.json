{
  "manifest_version": 3,
  "name": "Pager",
  "version": "0.2.0",
  "description": "A shared community discussion layer for every page on the web.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "Open Pager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
